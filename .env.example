# ============================================================
# HelthyFood - Environment Variables Template
# Copy this to .env.local and fill in your values
# ============================================================

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URLs (required for production)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Gemini AI (optional - for AI product descriptions in admin)
GEMINI_API_KEY=your-gemini-api-key

# VNPAY Sandbox Secret (required for payment simulation security)
# Generate a random secret: openssl rand -hex 32
VNPAY_SANDBOX_SECRET=change-me-to-a-random-secret
